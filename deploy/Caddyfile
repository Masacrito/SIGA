# SITE_ADDRESS = dominio (p. ej. 3-15-20-8.sslip.io) -> Caddy saca el certificado HTTPS solo.
# SITE_ADDRESS = :80 -> solo HTTP, sin certificado.
{$SITE_ADDRESS} {
	encode zstd gzip

	header {
		-Server
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
	}

	# API Laravel: todo entra por public/index.php del contenedor "app"
	@laravel path /api/* /up
	handle @laravel {
		root * /var/www/html/public
		rewrite * /index.php
		reverse_proxy app:9000 {
			transport fastcgi {
				split .php
			}
		}
	}

	# Sistema web (Vue, modo history): cualquier otra ruta cae en index.html
	handle {
		root * /srv
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}

	log
}
